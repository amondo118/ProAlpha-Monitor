# Copy to .env and adjust. Compose reads .env automatically.

# Port the dashboard is reachable on (dev default 8080, prod default 80)
WEB_PORT=100

# Host folder where SAP export files land (production: e.g. /srv/dashboard/exports)
# EXPORTS_DIR=./exports

# Time zone for log timestamps (dates on the page follow the browser)
# TZ=Europe/Budapest

# Seconds between checks for new export files
# IMPORT_INTERVAL=60

# Ignore export files changed less than this many seconds ago (still being written)
# STABLE_SECONDS=60
